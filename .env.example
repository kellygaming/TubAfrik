# ── Supabase (le MÊME projet que Kelly Gaming) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://cygqjsrztuphjmaftmgg.supabase.co
# Clé publique (« anon » ou « publishable »): RLS protège les tables tub_*
