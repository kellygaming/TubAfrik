SUPABASE_SERVICE_ROLE_KEY=

# ── Bunny Stream ──────────────────────────────────────────────────
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Nom d'hôte du CDN de la bibliothèque, ex. vz-12345678-abc.b-cdn.net
NEXT_PUBLIC_BUNNY_CDN_HOSTNAME=
# Chaîne aléatoire longue, recopiée dans l'URL du webhook Bunny
BUNNY_WEBHOOK_SECRET=

# ── Site ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tubafrik.vercel.app
# Adresses autorisées sur /admin, séparées par des virgules
ADMIN_EMAILS=

# ── Chariow (cadeaux en mobile money) ─────────────────────────────
